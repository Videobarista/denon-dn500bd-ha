          "host": "Host",
          "port": "Port",
          "add_offline": "Add even if the player is switched off now"
        },
        "data_description": {
          "host": "IP address or hostname of the player (Setup > Network > Information on the player).",
          "port": "Leave at 9030 unless you route the connection through something else.",
          "add_offline": "The supported features are detected the first time the player answers."
        }
      },
      "reconfigure": {
        "title": "Change address",
        "description": "Enter the new address of the player.",
        "data": {
          "host": "Host",
          "port": "Port"
        },
        "data_description": {
          "host": "IP address or hostname of the player (Setup > Network > Information on the player).",
          "port": "Leave at 9030 unless you route the connection through something else."
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot reach the player. Check the address, that the player is switched on, and that no other controller is connected to port 9030."
    },
    "abort": {
